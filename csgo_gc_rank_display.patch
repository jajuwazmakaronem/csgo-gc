diff --git a/csgo_gc/gc_client.cpp b/csgo_gc/gc_client.cpp
index cb683d3..cba544f 100644
--- a/csgo_gc/gc_client.cpp
+++ b/csgo_gc/gc_client.cpp
@@ -1457,26 +1457,34 @@ void ClientGC::ClientRequestPlayersProfile(GCMessageRead &messageRead)
         response.set_request_id(request.request_id__deprecated());
     }
 
-    // The local GC does not know authoritative profile data for another user.
-    // Return only the requested account id instead of copying local player state.
-    auto addMinimalProfile = [&response](uint32_t accountId)
+    // The local GC can provide our own profile from the same data as the
+    // initial matchmaking hello. Never expose that profile as another user.
+    auto addProfile = [this, &response](uint32_t accountId)
     {
         if (!accountId)
         {
             return;
         }
 
-        response.add_account_profiles()->set_account_id(accountId);
+        auto *profile = response.add_account_profiles();
+        if (accountId == AccountId())
+        {
+            BuildMatchmakingHello(*profile);
+        }
+        else
+        {
+            profile->set_account_id(accountId);
+        }
     };
 
     if (request.has_account_id())
     {
-        addMinimalProfile(request.account_id());
+        addProfile(request.account_id());
     }
 
     for (uint32_t accountId : request.account_ids__deprecated())
     {
-        addMinimalProfile(accountId);
+        addProfile(accountId);
     }
 
     SendMessageToGame(false, k_EMsgGCCStrike15_v2_PlayersProfile, response);
@@ -1784,6 +1792,25 @@ void ClientGC::BuildMatchmakingHello(CMsgGCCStrike15_v2_MatchmakingGC2ClientHell
 {
     message.set_account_id(AccountId());
 
+    // Some Panorama views read the ranking included in the profile/hello,
+    // while others consume the separate ClientGCRankUpdate message.
+    auto setRank = [this](PlayerRankingInfo *rank, uint32_t rankId, int wins, uint32_t type)
+    {
+        rank->set_account_id(AccountId());
+        rank->set_rank_id(rankId);
+        rank->set_wins(wins);
+        rank->set_rank_type_id(type);
+    };
+
+    setRank(message.mutable_ranking(), GetConfig().m_competitiveRank,
+        GetConfig().m_competitiveWins, RankTypeCompetitive);
+    setRank(message.add_rankings(), GetConfig().m_competitiveRank,
+        GetConfig().m_competitiveWins, RankTypeCompetitive);
+    setRank(message.add_rankings(), GetConfig().m_wingmanRank,
+        GetConfig().m_wingmanWins, RankTypeWingman);
+    setRank(message.add_rankings(), GetConfig().m_dangerZoneRank,
+        GetConfig().m_dangerZoneWins, RankTypeDangerZone);
+
     // this is the state of csgo matchmaking in 2024
     message.mutable_global_stats()->set_players_online(0);
     message.mutable_global_stats()->set_servers_online(0);
